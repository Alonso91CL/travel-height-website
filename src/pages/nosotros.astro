---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatsBar from "../components/StatsBar.astro";

const teamImg = "/images/nosotros-equipo.jpg";
const installationImg = "/images/nosotros-mision.jpg";
const heroBg = "/images/nosotros-hero.jpg";
const visionImg = "/images/nosotros-vision.jpg";
---

<BaseLayout
  title="Nosotros | Travel Height Elevadores"
  description="Conoce a Travel Height: más de 15 años elevando estándares de seguridad vertical en Latinoamérica con ingeniería certificada y un equipo de expertos."
  image="/images/nosotros-hero.jpg"
  currentPage="/nosotros/"
>
  <main>
    <section class="relative bg-navy-deep overflow-hidden hero-clip min-h-[75vh]" style="background-color: #131a33;">
      <div class="absolute inset-0 opacity-40 mix-blend-overlay">
        <div class="w-full h-full bg-cover bg-center" style={`background-image: url('${heroBg}')`}></div>
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/30 to-transparent"></div>
      <div class="relative z-10 px-margin-mobile md:px-margin-desktop pt-40 pb-section-padding max-w-container-max mx-auto">
        <div class="hero-content max-w-2xl">
          <span class="font-label-bold text-label-sm text-electric-cyan uppercase tracking-[0.2em] mb-4 block">DESDE 2008</span>
          <h1 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-white mb-6">
            Ingeniería que Eleva Estándares
          </h1>
          <p class="font-body-lg text-body-lg text-gray-300 mb-8">
            En Travel Height, transformamos la movilidad vertical en una experiencia de seguridad, precisión y tecnología avanzada. Establecidos en Chile hace más de 15 años, somos el aliado estratégico para proyectos que exigen excelencia técnica.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/proyectos/" class="bg-electric-cyan text-navy-deep font-label-bold px-8 py-4 rounded-xl hover:opacity-90 transition-all hover-lift press">
              Ver Proyectos
            </a>
            <a href="/cotizacion/" class="border border-white/20 text-white font-label-bold px-8 py-4 rounded-xl hover:bg-white/10 transition-all hover-lift">
              Contáctenos
            </a>
          </div>
        </div>
      </div>
    </section>

    <StatsBar />

    <section class="px-margin-mobile md:px-margin-desktop py-section-padding bg-surface reveal" style="background-image: radial-gradient(circle, #e4e2e4 1px, transparent 1px); background-size: 32px 32px;">
      <div class="max-w-container-max mx-auto grid md:grid-cols-12 gap-gutter items-stretch stagger">
        <div class="md:col-span-7 bg-white rounded-2xl p-10 ambient-shadow border-l-4 border-primary flex flex-col justify-center">
          <span class="font-label-bold text-label-sm text-electric-cyan uppercase tracking-wider">Misión</span>
          <h3 class="font-headline-md text-headline-md text-primary mt-2 mb-4">Nuestra Misión</h3>
          <p class="text-on-surface-variant font-body-lg leading-relaxed">
            Proveer soluciones de transporte vertical integrales, garantizando la continuidad operacional y la seguridad absoluta de los usuarios a través de una ingeniería rigurosa y un servicio técnico de respuesta inmediata.
          </p>
        </div>
        <div class="md:col-span-5 h-64 md:h-auto rounded-2xl overflow-hidden ambient-shadow">
          <div class="w-full h-full bg-cover bg-center" style={`background-image: url('${installationImg}')`}></div>
        </div>
        <div class="hidden md:block md:col-span-5 rounded-2xl overflow-hidden ambient-shadow">
          <div class="w-full h-full bg-cover bg-center" style={`background-image: url('${visionImg}')`}></div>
        </div>
        <div class="md:col-span-7 rounded-2xl p-10 ambient-shadow flex flex-col justify-center bg-[#131a33]" style="background-color: #131a33;">
          <span class="font-label-bold text-label-sm text-electric-cyan uppercase tracking-wider">Visión</span>
          <h3 class="font-headline-md text-headline-md text-white mt-2 mb-4">Nuestra Visión</h3>
          <p class="text-gray-300 font-body-lg leading-relaxed">
            Ser reconocidos como el referente de excelencia en Chile para la modernización y mantenimiento de ascensores, liderando la industria mediante la integración de tecnologías inteligentes y sostenibilidad operativa.
          </p>
        </div>
      </div>
    </section>

    <!-- Values -->
    <section class="bg-white px-margin-mobile md:px-margin-desktop py-section-padding reveal">
      <div class="max-w-container-max mx-auto">
        <div class="text-center mb-16">
          <h2 class="font-headline-md text-headline-md text-primary">Nuestros Valores Fundamentales</h2>
          <div class="w-20 h-1 bg-electric-cyan mx-auto mt-4"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-gutter stagger">
          <div class="bg-white rounded-xl p-8 ambient-shadow border border-outline-variant card-hover hover:border-electric-cyan transition-all hover-lift">
            <span class="material-symbols-outlined text-4xl text-primary mb-6" style="font-variation-settings: 'FILL' 1;">precision_manufacturing</span>
            <h3 class="font-headline-sm text-headline-sm text-primary mb-3">Innovación</h3>
            <p class="text-on-surface-variant font-body-md">Adoptamos las últimas tecnologías globales en sistemas de control y eficiencia energética.</p>
          </div>
          <div class="bg-white rounded-xl p-8 ambient-shadow border border-outline-variant card-hover hover:border-electric-cyan transition-all hover-lift">
            <span class="material-symbols-outlined text-4xl text-primary mb-6" style="font-variation-settings: 'FILL' 1;">security</span>
            <h3 class="font-headline-sm text-headline-sm text-primary mb-3">Seguridad</h3>
            <p class="text-on-surface-variant font-body-md">Protocolos estrictos de inspección técnica para garantizar riesgo cero en cada ascenso.</p>
          </div>
          <div class="bg-white rounded-xl p-8 ambient-shadow border border-outline-variant card-hover hover:border-electric-cyan transition-all hover-lift">
            <span class="material-symbols-outlined text-4xl text-primary mb-6" style="font-variation-settings: 'FILL' 1;">architecture</span>
            <h3 class="font-headline-sm text-headline-sm text-primary mb-3">Precisión</h3>
            <p class="text-on-surface-variant font-body-md">Ingeniería de detalle aplicada a cada componente, desde el motor hasta los acabados.</p>
          </div>
          <div class="bg-white rounded-xl p-8 ambient-shadow border border-outline-variant card-hover hover:border-electric-cyan transition-all hover-lift">
            <span class="material-symbols-outlined text-4xl text-primary mb-6" style="font-variation-settings: 'FILL' 1;">handshake</span>
            <h3 class="font-headline-sm text-headline-sm text-primary mb-3">Compromiso</h3>
            <p class="text-on-surface-variant font-body-md">Presencia local 24/7 para asegurar que su edificio nunca se detenga.</p>
          </div>
        </div>
      </div>
    </section>


    <!-- Expertise & Certifications -->
    <section class="px-margin-mobile md:px-margin-desktop py-section-padding bg-[#131a33] relative overflow-hidden reveal">
      <div class="absolute right-0 top-0 w-1/3 h-full opacity-5 pointer-events-none">
        <span class="material-symbols-outlined text-[400px] text-white">engineering</span>
      </div>
      <div class="max-w-container-max mx-auto relative z-10">
        <div class="flex flex-col lg:flex-row gap-stack-lg items-center">
          <div class="lg:w-1/2 text-white">
            <h2 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg mb-8">Expertiz Técnica Certificada</h2>
            <p class="font-body-lg text-body-lg text-gray-300 mb-12">
              Nuestro equipo está compuesto por ingenieros mecánicos y eléctricos especializados con décadas de experiencia en el mercado chileno. No solo instalamos equipos; diseñamos soluciones de vida para infraestructuras complejas.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-stack-md">
              <div class="flex items-center gap-4 bg-white/10 p-6 rounded-lg border border-white/20">
                <span class="material-symbols-outlined text-electric-cyan text-3xl" style="font-variation-settings: 'FILL' 1;">verified</span>
                <div>
                  <h4 class="font-label-bold text-label-bold">Certificación NCH 440</h4>
                  <p class="text-xs text-gray-400">Norma Chilena de Ascensores</p>
                </div>
              </div>
              <div class="flex items-center gap-4 bg-white/10 p-6 rounded-lg border border-white/20">
                <span class="material-symbols-outlined text-electric-cyan text-3xl" style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
                <div>
                  <h4 class="font-label-bold text-label-bold">ISO 9001:2015</h4>
                  <p class="text-xs text-gray-400">Gestión de Calidad Internacional</p>
                </div>
              </div>
              <div class="flex items-center gap-4 bg-white/10 p-6 rounded-lg border border-white/20">
                <span class="material-symbols-outlined text-electric-cyan text-3xl" style="font-variation-settings: 'FILL' 1;">health_and_safety</span>
                <div>
                  <h4 class="font-label-bold text-label-bold">Mutual de Seguridad</h4>
                  <p class="text-xs text-gray-400">Altos estándares de prevención</p>
                </div>
              </div>
              <div class="flex items-center gap-4 bg-white/10 p-6 rounded-lg border border-white/20">
                <span class="material-symbols-outlined text-electric-cyan text-3xl" style="font-variation-settings: 'FILL' 1;">construction</span>
                <div>
                  <h4 class="font-label-bold text-label-bold">Registro MINVU</h4>
                  <p class="text-xs text-gray-400">Proveedores de alta categoría</p>
                </div>
              </div>
            </div>
          </div>
          <div class="lg:w-1/2 relative">
            <div class="aspect-square w-full rounded-2xl overflow-hidden shadow-2xl relative z-10">
              <div class="w-full h-full bg-cover bg-center" style={`background-image: url('${teamImg}')`}></div>
            </div>
            <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-electric-cyan rounded-full mix-blend-screen blur-3xl opacity-30"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="py-16 bg-surface-container-highest border-y border-outline-variant reveal">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
          <div>
            <div class="font-display-lg text-primary text-4xl mb-2">15+</div>
            <div class="font-label-bold text-label-bold text-on-surface-variant">AÑOS EN CHILE</div>
          </div>
          <div>
            <div class="font-display-lg text-primary text-4xl mb-2">500+</div>
            <div class="font-label-bold text-label-bold text-on-surface-variant">PROYECTOS ACTIVOS</div>
          </div>
          <div>
            <div class="font-display-lg text-primary text-4xl mb-2">24/7</div>
            <div class="font-label-bold text-label-bold text-on-surface-variant">SOPORTE TÉCNICO</div>
          </div>
          <div>
            <div class="font-display-lg text-primary text-4xl mb-2">0</div>
            <div class="font-label-bold text-label-bold text-on-surface-variant">INCIDENTES GRAVES</div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
