---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Solicitar Cotización | Travel Height"
  description="Solicita tu cotización de instalación, mantenimiento o modernización de elevadores. Visita técnica sin costo y respuesta en 24 horas en todo Chile."
  currentPage="/cotizacion/"
>
  <main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop pt-32 pb-section-padding blueprint-pattern">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left: Value Propositions -->
      <div class="lg:col-span-5 space-y-10">
        <div class="space-y-4 hero-content">
          <span class="inline-block px-3 py-1 bg-black text-white text-label-bold rounded-full uppercase tracking-widest text-[10px]">Solicitud de Cotización</span>
          <h1 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-primary">
            Elevamos sus estándares de movilidad.
          </h1>
          <p class="font-body-lg text-body-lg text-on-surface-variant max-w-md">
            Desde la ingeniería de precisión hasta el mantenimiento preventivo. Obtenga una solución integral diseñada por expertos.
          </p>
        </div>
        <div class="space-y-8 stagger">
          <div class="flex gap-4 group">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-white shadow-[0_10px_30px_rgba(11,19,43,0.08)] flex items-center justify-center border-b-2 border-transparent group-hover:border-electric-cyan transition-all duration-300">
              <span class="material-symbols-outlined text-primary">engineering</span>
            </div>
            <div>
              <h3 class="font-headline-sm text-headline-sm mb-1">Visita Técnica Sin Costo</h3>
              <p class="text-on-surface-variant font-body-md">Un ingeniero certificado evaluará su proyecto en sitio para garantizar la viabilidad técnica total.</p>
            </div>
          </div>
          <div class="flex gap-4 group">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-white shadow-[0_10px_30px_rgba(11,19,43,0.08)] flex items-center justify-center border-b-2 border-transparent group-hover:border-electric-cyan transition-all duration-300">
              <span class="material-symbols-outlined text-primary">timer</span>
            </div>
            <div>
              <h3 class="font-headline-sm text-headline-sm mb-1">Respuesta en 24 Horas</h3>
              <p class="text-on-surface-variant font-body-md">Sabemos que el tiempo es crítico. Reciba su presupuesto detallado y cronograma en menos de un día.</p>
            </div>
          </div>
          <div class="flex gap-4 group">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-white shadow-[0_10px_30px_rgba(11,19,43,0.08)] flex items-center justify-center border-b-2 border-transparent group-hover:border-electric-cyan transition-all duration-300">
              <span class="material-symbols-outlined text-primary">verified</span>
            </div>
            <div>
              <h3 class="font-headline-sm text-headline-sm mb-1">Garantía Estructural</h3>
              <p class="text-on-surface-variant font-body-md">Nuestros equipos y procesos cumplen con las normas internacionales de seguridad más estrictas.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Multi-step Form -->
      <div class="lg:col-span-7">
        <div class="rounded-[24px] p-8 md:p-12 shadow-[0_10px_30px_rgba(11,19,43,0.08)] border border-white/50 relative overflow-hidden" style="background: rgba(255,255,255,0.85); backdrop-filter: blur(12px);">
          <!-- Progress Bar -->
          <div class="absolute top-0 left-0 w-full h-1 bg-surface-container-highest">
            <div class="h-full bg-electric-cyan transition-all duration-500 ease-out" id="progress-bar" style="width: 33%"></div>
          </div>

          <form class="space-y-8" id="quote-form">
            <!-- Step 1: Identification -->
            <div class="step-transition" id="step-1">
              <div class="mb-8">
                <h2 class="font-headline-md text-headline-md mb-2">Comencemos con lo básico</h2>
                <p class="text-on-surface-variant">Información de contacto profesional.</p>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-2">
                  <label class="font-label-bold text-label-bold text-on-surface">Nombre Completo</label>
                  <input class="w-full px-4 py-3 bg-surface-container-low border-none rounded-lg focus:ring-2 focus:ring-electric-cyan focus:bg-white transition-all outline-none" placeholder="Ej. Carlos Mendoza" type="text" name="nombre" />
                </div>
                <div class="space-y-2">
                  <label class="font-label-bold text-label-bold text-on-surface">Empresa / Copropiedad</label>
                  <input class="w-full px-4 py-3 bg-surface-container-low border-none rounded-lg focus:ring-2 focus:ring-electric-cyan focus:bg-white transition-all outline-none" placeholder="Nombre de la entidad" type="text" name="empresa" />
                </div>
                <div class="space-y-2">
                  <label class="font-label-bold text-label-bold text-on-surface">Correo Electrónico</label>
                  <input class="w-full px-4 py-3 bg-surface-container-low border-none rounded-lg focus:ring-2 focus:ring-electric-cyan focus:bg-white transition-all outline-none" placeholder="carlos@empresa.com" type="email" name="email" />
                </div>
                <div class="space-y-2">
                  <label class="font-label-bold text-label-bold text-on-surface">Teléfono</label>
                  <input class="w-full px-4 py-3 bg-surface-container-low border-none rounded-lg focus:ring-2 focus:ring-electric-cyan focus:bg-white transition-all outline-none" placeholder="+56 2..." type="tel" name="telefono" />
                </div>
              </div>
              <div class="mt-10 flex justify-end">
                <button type="button" id="step1-next" class="px-8 py-4 bg-black text-white font-label-bold rounded-lg flex items-center gap-2 hover:bg-zinc-800 transition-colors active:scale-95 duration-200">
                  Siguiente Paso
                  <span class="material-symbols-outlined">arrow_forward</span>
                </button>
              </div>
            </div>

            <!-- Step 2: Project Details -->
            <div class="step-transition hidden opacity-0 translate-x-8" id="step-2">
              <div class="mb-8">
                <h2 class="font-headline-md text-headline-md mb-2">Sobre su Infraestructura</h2>
                <p class="text-on-surface-variant">Ayúdenos a entender sus necesidades específicas.</p>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-2">
                  <label class="font-label-bold text-label-bold text-on-surface">Tipo de Edificación</label>
                  <select class="w-full px-4 py-3 bg-surface-container-low border-none rounded-lg focus:ring-2 focus:ring-electric-cyan focus:bg-white transition-all outline-none appearance-none" name="edificacion">
                    <option>Residencial</option>
                    <option>Oficinas / Corporativo</option>
                    <option>Industrial / Carga</option>
                    <option>Hospitalario</option>
                    <option>Comercial</option>
                  </select>
                </div>
                <div class="space-y-2">
                  <label class="font-label-bold text-label-bold text-on-surface">Servicio Requerido</label>
                  <select class="w-full px-4 py-3 bg-surface-container-low border-none rounded-lg focus:ring-2 focus:ring-electric-cyan focus:bg-white transition-all outline-none appearance-none" name="servicio">
                    <option>Instalación Equipo Nuevo</option>
                    <option>Mantenimiento Mensual</option>
                    <option>Modernización Tecnológica</option>
                    <option>Reparación Mayor</option>
                  </select>
                </div>
                <div class="space-y-2 md:col-span-2">
                  <label class="font-label-bold text-label-bold text-on-surface">Número de Paradas (Pisos)</label>
                  <div class="flex gap-4">
                    <label class="flex-1 cursor-pointer">
                      <input class="sr-only peer" name="floors" type="radio" value="1-5" />
                      <div class="text-center py-3 border border-outline-variant rounded-lg peer-checked:bg-black peer-checked:text-white peer-checked:border-black transition-all">1-5</div>
                    </label>
                    <label class="flex-1 cursor-pointer">
                      <input class="sr-only peer" name="floors" type="radio" value="6-15" />
                      <div class="text-center py-3 border border-outline-variant rounded-lg peer-checked:bg-black peer-checked:text-white peer-checked:border-black transition-all">6-15</div>
                    </label>
                    <label class="flex-1 cursor-pointer">
                      <input class="sr-only peer" name="floors" type="radio" value="16-30" />
                      <div class="text-center py-3 border border-outline-variant rounded-lg peer-checked:bg-black peer-checked:text-white peer-checked:border-black transition-all">16-30</div>
                    </label>
                    <label class="flex-1 cursor-pointer">
                      <input class="sr-only peer" name="floors" type="radio" value="30+" />
                      <div class="text-center py-3 border border-outline-variant rounded-lg peer-checked:bg-black peer-checked:text-white peer-checked:border-black transition-all">30+</div>
                    </label>
                  </div>
                </div>
              </div>
              <div class="mt-10 flex justify-between items-center">
                <button type="button" id="step2-back" class="text-on-surface-variant font-label-bold hover:text-primary transition-colors flex items-center gap-2">
                  <span class="material-symbols-outlined">arrow_back</span>
                  Atrás
                </button>
                <button type="button" id="step2-next" class="px-8 py-4 bg-black text-white font-label-bold rounded-lg flex items-center gap-2 hover:bg-zinc-800 transition-colors active:scale-95 duration-200">
                  Continuar
                  <span class="material-symbols-outlined">arrow_forward</span>
                </button>
              </div>
            </div>

            <!-- Step 3: Priority & Submit -->
            <div class="step-transition hidden opacity-0 translate-x-8" id="step-3">
              <div class="mb-8">
                <h2 class="font-headline-md text-headline-md mb-2">Finalizando</h2>
                <p class="text-on-surface-variant">¿Qué tan pronto requiere nuestro servicio?</p>
              </div>
              <div class="space-y-8">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <label class="cursor-pointer group">
                    <input class="sr-only peer" name="urgency" type="radio" value="Próximos 3 meses" />
                    <div class="h-full p-6 border border-outline-variant rounded-xl text-center transition-all peer-checked:border-electric-cyan peer-checked:bg-electric-cyan/5 peer-checked:shadow-lg">
                      <span class="material-symbols-outlined text-3xl mb-2 text-on-surface-variant group-hover:text-electric-cyan">calendar_today</span>
                      <div class="font-label-bold">Próximos 3 meses</div>
                    </div>
                  </label>
                  <label class="cursor-pointer group">
                    <input class="sr-only peer" name="urgency" type="radio" value="Lo antes posible" />
                    <div class="h-full p-6 border border-outline-variant rounded-xl text-center transition-all peer-checked:border-electric-cyan peer-checked:bg-electric-cyan/5 peer-checked:shadow-lg">
                      <span class="material-symbols-outlined text-3xl mb-2 text-on-surface-variant group-hover:text-electric-cyan">bolt</span>
                      <div class="font-label-bold">Lo antes posible</div>
                    </div>
                  </label>
                  <label class="cursor-pointer group">
                    <input class="sr-only peer" name="urgency" type="radio" value="Planificación Anual" />
                    <div class="h-full p-6 border border-outline-variant rounded-xl text-center transition-all peer-checked:border-electric-cyan peer-checked:bg-electric-cyan/5 peer-checked:shadow-lg">
                      <span class="material-symbols-outlined text-3xl mb-2 text-on-surface-variant group-hover:text-electric-cyan">schedule</span>
                      <div class="font-label-bold">Planificación Anual</div>
                    </div>
                  </label>
                </div>
                <div class="space-y-2">
                  <label class="font-label-bold text-label-bold text-on-surface">Comentarios Adicionales (Opcional)</label>
                  <textarea class="w-full px-4 py-3 bg-surface-container-low border-none rounded-lg focus:ring-2 focus:ring-electric-cyan focus:bg-white transition-all outline-none resize-none" placeholder="Cuéntenos más detalles técnicos o requisitos especiales..." rows="4" name="comentarios"></textarea>
                </div>
              </div>
              <div class="mt-10 flex justify-between items-center">
                <button type="button" id="step3-back" class="text-on-surface-variant font-label-bold hover:text-primary transition-colors flex items-center gap-2">
                  <span class="material-symbols-outlined">arrow_back</span>
                  Atrás
                </button>
                <button type="button" id="step3-submit" class="px-10 py-4 bg-electric-cyan text-black font-label-bold rounded-lg flex items-center gap-2 hover:brightness-110 shadow-lg shadow-electric-cyan/20 transition-all active:scale-95 duration-200">
                  Enviar Solicitud
                  <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">send</span>
                </button>
              </div>
            </div>
          </form>

          <!-- Success Screen -->
          <div id="success-screen" class="hidden flex-col items-center justify-center py-12 text-center">
            <div class="w-20 h-20 rounded-full bg-green-100 flex items-center justify-center mb-6">
              <span class="material-symbols-outlined text-4xl text-green-600">check_circle</span>
            </div>
            <h2 class="font-headline-md text-headline-md mb-2">¡Solicitud Enviada!</h2>
            <p class="text-on-surface-variant mb-8 max-w-sm">Un asesor técnico revisará su información y se pondrá en contacto en un plazo máximo de 24 horas.</p>
            <button type="button" class="font-label-bold text-primary underline underline-offset-4" onclick="location.reload()">Hacer otra cotización</button>
          </div>
        </div>
      </div>
    </div>
  </main>

  <style>
    .blueprint-pattern {
      background-color: #fcf8fb;
      background-image:
        linear-gradient(#e4e2e4 1px, transparent 1px),
        linear-gradient(90deg, #e4e2e4 1px, transparent 1px);
      background-size: 40px 40px;
      background-position: center center;
    }
  </style>

  <script>
    import { whatsappUrl } from "../config/site";

    const byId = <T extends HTMLElement>(id: string): T | null =>
      document.getElementById(id) as T | null;

    function goToStep(step: number) {
      document.querySelectorAll(".step-transition").forEach((el) => {
        el.classList.add("hidden", "opacity-0", "translate-x-8");
        el.classList.remove("translate-x-0", "opacity-100");
      });
      const target = byId(`step-${step}`);
      if (target) {
        target.classList.remove("hidden");
        setTimeout(() => {
          target.classList.remove("opacity-0", "translate-x-8");
          target.classList.add("opacity-100", "translate-x-0");
        }, 50);
      }
      const bar = byId("progress-bar");
      if (bar) bar.style.width = `${(step / 3) * 100}%`;
    }

    function showSuccess() {
      const form = byId("quote-form");
      const screen = byId("success-screen");
      const bar = byId("progress-bar");
      if (form) form.style.display = "none";
      if (screen) {
        screen.classList.remove("hidden");
        screen.classList.add("flex");
      }
      if (bar) bar.style.width = "100%";
    }

    function getRadioValue(form: HTMLFormElement, name: string): string {
      const checked = form.querySelector<HTMLInputElement>(
        `input[name="${name}"]:checked`,
      );
      return checked ? checked.value : "";
    }

    function submitQuote() {
      const form = byId<HTMLFormElement>("quote-form");
      if (!form) return;
      const data = new FormData(form);
      const nombre = String(data.get("nombre") || "").trim();
      const email = String(data.get("email") || "").trim();

      if (!nombre || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        alert("Completa tu nombre y un correo electrónico válido en el primer paso.");
        goToStep(1);
        return;
      }

      const field = (name: string) => String(data.get(name) || "").trim();
      const lines = [
        "Hola, quiero solicitar una cotización.",
        `Nombre: ${nombre}`,
        field("empresa") && `Empresa: ${field("empresa")}`,
        `Email: ${email}`,
        field("telefono") && `Teléfono: ${field("telefono")}`,
        `Edificación: ${field("edificacion")}`,
        `Servicio: ${field("servicio")}`,
        `Paradas (pisos): ${getRadioValue(form, "floors") || "Sin especificar"}`,
        `Urgencia: ${getRadioValue(form, "urgency") || "Sin especificar"}`,
      ];
      const comentarios = field("comentarios");
      if (comentarios) lines.push(`Comentarios: ${comentarios}`);

      window.open(whatsappUrl(lines.filter(Boolean).join("\n")), "_blank", "noopener");
      showSuccess();
    }

    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;
      if (target.closest("#step1-next")) goToStep(2);
      else if (target.closest("#step2-next")) goToStep(3);
      else if (target.closest("#step2-back")) goToStep(1);
      else if (target.closest("#step3-back")) goToStep(2);
      else if (target.closest("#step3-submit")) submitQuote();
    });
  </script>
</BaseLayout>
