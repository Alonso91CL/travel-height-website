---
export interface Props {
  backgroundImage?: string;
  gradientFrom?: string;
  gradientVia?: string;
  gradientTo?: string;
  minHeight?: string;
  badge?: string;
  badgeHtml?: string;
  badgeClass?: string;
  title: string;
  description: string;
  primaryCta?: { text: string; href: string; class?: string; icon?: string };
  secondaryCta?: { text: string; href: string; class?: string; icon?: string };
  rightImage?: string;
  rightAlt?: string;
  withBlurCircle?: boolean;
  contentClass?: string;
  children?: any;
}

const {
  backgroundImage,
  gradientFrom = "from-black/60",
  gradientVia = "via-black/30",
  gradientTo = "to-transparent",
  minHeight = "min-h-[75vh]",
  badge,
  badgeHtml,
  badgeClass = "bg-error-container text-on-error-container rounded-full",
  title,
  description,
  primaryCta,
  secondaryCta,
  rightImage,
  rightAlt = "",
  withBlurCircle = false,
  contentClass = "py-section-padding",
} = Astro.props;

const textLight = !!backgroundImage;
---

<section
  class:list={["relative", minHeight, "flex items-center overflow-hidden"]}
>
  {backgroundImage && (
    <div class="absolute inset-0 z-0">
      <img
        alt="Background"
        class="w-full h-full object-cover"
        src={backgroundImage}
      />
      <div
        class:list={[
          "absolute inset-0 bg-gradient-to-r",
          gradientFrom,
          gradientVia,
          gradientTo,
        ]}
      ></div>
    </div>
  )}
  <div
    class:list={[
      "relative z-10 w-full px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto",
      contentClass,
      { "grid md:grid-cols-2 gap-gutter items-center": rightImage },
    ]}
  >
    <div class={rightImage ? "" : "hero-content max-w-2xl"}>
      <div class={rightImage ? "hero-content space-y-stack-lg" : "space-y-stack-lg"}>
        {(badge || badgeHtml) && (
          <div class:list={["inline-flex items-center gap-2 px-3 py-1", badgeClass]}>
            {badgeHtml ? <Fragment set:html={badgeHtml} /> : badge}
          </div>
        )}
        <h1
          class:list={[
            "font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg",
            textLight ? "text-white" : "text-primary",
            { "mb-6": !rightImage },
          ]}
        >
          {title}
        </h1>
        <p class:list={["font-body-lg text-body-lg", textLight ? "text-white/80" : "text-on-surface-variant", rightImage ? "" : "max-w-xl"]}>
          {description}
        </p>
        {(primaryCta || secondaryCta) && (
          <div class="flex flex-wrap gap-4 pt-2">
            {primaryCta && (
              <a
                href={primaryCta.href}
                class:list={[
                  "inline-flex items-center justify-center gap-3 font-label-bold text-label-bold px-8 py-4 rounded-xl transition-all hover-lift group",
                  primaryCta.class ||
                    "bg-error text-white hover:bg-red-700 shadow-lg",
                ]}
              >
                {primaryCta.icon && (
                  <span class="material-symbols-outlined text-2xl group-hover:rotate-12 transition-transform">
                    {primaryCta.icon}
                  </span>
                )}
                {primaryCta.text}
              </a>
            )}
            {secondaryCta && (
              <a
                href={secondaryCta.href}
                class:list={[
                  "inline-flex items-center justify-center gap-3 font-label-bold text-label-bold px-8 py-4 rounded-xl border-2 transition-all ambient-shadow hover-lift",
                  secondaryCta.class ||
                    "border-outline-variant text-primary hover:border-electric-cyan bg-white",
                ]}
              >
                {secondaryCta.icon && (
                  <span class="material-symbols-outlined text-2xl text-on-primary-container">
                    {secondaryCta.icon}
                  </span>
                )}
                {secondaryCta.text}
              </a>
            )}
          </div>
        )}
      </div>
    </div>
    {rightImage && (
      <div class="relative hidden md:block">
        {withBlurCircle && (
          <div class="absolute -top-12 -right-12 w-64 h-64 bg-secondary-container/20 rounded-full blur-3xl"></div>
        )}
        <div class="relative rounded-2xl overflow-hidden ambient-shadow border border-white/50">
          <img class="w-full h-full object-cover" src={rightImage} alt={rightAlt} />
        </div>
      </div>
    )}
  </div>
</section>
