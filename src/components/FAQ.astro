---
import JsonLd from "./seo/JsonLd.astro";

export interface Props {
  items: Array<{ question: string; answer: string }>;
  title: string;
  description: string;
}
const { items, title, description } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<JsonLd data={faqSchema} />

<section class="bg-surface-container-low px-margin-mobile md:px-margin-desktop py-section-padding reveal">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-stack-lg">
      <h2 class="font-headline-md text-headline-md text-primary">{title}</h2>
      <p class="text-on-surface-variant mt-2">{description}</p>
    </div>
    <div class="space-y-4 stagger">
      {items.map((item, i) => (
        <details class="group bg-white rounded-xl ambient-shadow overflow-hidden hover-lift" {...(i === 0 ? { open: true } : {})}>
          <summary class="flex justify-between items-center p-6 cursor-pointer list-none font-headline-sm text-primary group-open:bg-surface-container-high transition-colors">
            <span>{item.question}</span>
            <span class="material-symbols-outlined transition-transform group-open:rotate-180">
              expand_more
            </span>
          </summary>
          <div class="p-6 text-on-surface-variant font-body-md leading-relaxed border-t border-outline-variant/30">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
