---
import JsonLd from "./JsonLd.astro";
import { navLinks, siteConfig } from "../../config/site";

export interface Props {
  pathname?: string;
}

const fallbackLabels: Record<string, string> = {
  privacidad: "Política de Privacidad",
  terminos: "Términos y Condiciones",
  "eliminar-datos": "Eliminar Datos",
};

const requested = Astro.props.pathname ?? Astro.url.pathname;
const pathname = requested.replace(/\/?$/, "/");
const segments = pathname.split("/").filter(Boolean);

const trail: Array<{ name: string; item: string }> = [
  { name: "Inicio", item: `${siteConfig.url}/` },
];
let acc = "";
for (const segment of segments) {
  acc += `/${segment}`;
  const href = `${acc}/`;
  const label =
    navLinks.find((link) => link.href === href)?.label ??
    fallbackLabels[segment] ??
    segment.charAt(0).toUpperCase() + segment.slice(1);
  trail.push({ name: label, item: `${siteConfig.url}${href}` });
}
---

{
  trail.length > 1 && (
    <JsonLd
      data={{
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: trail.map((crumb, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: crumb.name,
          item: crumb.item,
        })),
      }}
    />
  )
}
