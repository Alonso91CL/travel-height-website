---
export interface Props {
  variant?: "emergency" | "default";
}
const { variant = "default" } = Astro.props;
const items =
  variant === "emergency"
    ? [
        { label: "Unidades Activas", value: "18", sub: "En Ruta" },
        { label: "Tiempo Promedio", value: "34", sub: "minutos" },
        { label: "Disponibilidad", value: "100%", sub: "", dot: "bg-green-500" },
        { label: "Último Reporte", value: "02:15", sub: "hace poco" },
      ]
    : [
        { label: "Años de Experiencia", value: "15+", sub: "" },
        { label: "Proyectos Completados", value: "500+", sub: "" },
        { label: "Soporte", value: "24/7", sub: "" },
        { label: "Certificaciones", value: "ISO 9001", sub: "" },
      ];
---

<section class="bg-surface-container-low py-12 border-y border-outline-variant/30 reveal">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-gutter text-center md:text-left stagger">
      {items.map((item) => (
        <div class="space-y-1">
          <p class="text-on-surface-variant font-label-bold text-label-sm uppercase">
            {item.label}
          </p>
          <div
            class:list={[
              "flex gap-2",
              item.dot ? "items-center" : "items-baseline",
              "justify-center md:justify-start",
            ]}
          >
            {item.dot && <span class:list={["w-3 h-3 rounded-full", item.dot]}></span>}
            <span class="font-headline-md text-headline-md text-primary">
              {item.value}
            </span>
            {item.sub && (
              <span class="text-on-primary-container font-label-bold text-label-bold">
                {item.sub}
              </span>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
