---
import { navLinks } from "../config/site";

export interface Props {
  currentPage?: string;
}
const { currentPage = "/" } = Astro.props;
---

<div
  id="mobile-menu-overlay"
  class="fixed inset-0 bg-black/40 z-[60] opacity-0 pointer-events-none transition-opacity duration-300"
></div>
<div
  id="mobile-menu-drawer"
  class="fixed top-0 right-0 h-full w-[85vw] max-w-sm bg-white z-[70] shadow-2xl translate-x-full transition-transform duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] flex flex-col"
>
  <div
    class="flex justify-between items-center px-6 py-5 border-b border-[#e4e2e4]"
  >
    <span class="font-bold text-lg text-[#1b1b1d]">Menú</span>
    <button
      class="p-2 text-[#1b1b1d] hover:opacity-60 transition-opacity"
      id="mobile-menu-close"
      aria-label="Cerrar menú"
    >
      <span class="material-symbols-outlined text-3xl">close</span>
    </button>
  </div>
  <nav
    class="flex flex-col gap-6 px-6 py-8 flex-1 overflow-y-auto"
    id="mobile-nav"
  >
    {
      navLinks.map((link) => (
        <a
          class:list={[
            "text-xl font-semibold text-[#1b1b1d] hover:text-black transition-colors nav-link",
            { active: currentPage === link.href },
          ]}
          href={link.href}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
  <div class="px-6 py-8 border-t border-[#e4e2e4]">
    <a
      href="/cotizacion/"
      class="block w-full bg-black text-white text-center px-6 py-4 rounded-xl font-bold text-base hover:opacity-80 transition-all active:scale-95"
    >
      Cotizar
    </a>
  </div>
</div>
