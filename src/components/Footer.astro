---
import { siteConfig } from "../config/site";
---

<footer
  class="w-full px-margin-mobile md:px-margin-desktop py-section-padding grid grid-cols-1 md:grid-cols-4 gap-gutter bg-[#303032] text-surface-bright border-t border-outline-variant"
>
  <div class="md:col-span-1">
    <div class="flex items-center gap-2 mb-6">
      <span class="material-symbols-outlined text-white text-headline-sm">
        elevator
      </span>
      <span
        class="text-headline-sm font-display-lg text-white tracking-tighter"
      >
        Travel Height
      </span>
    </div>
    <p class="text-surface-dim font-body-md text-body-md mb-6">
      Líderes en ingeniería de elevación vertical y soluciones tecnológicas
      para el transporte seguro de personas.
    </p>
  </div>
  <div>
    <h4
      class="text-white font-label-bold text-label-bold mb-6 uppercase tracking-wider"
    >
      Servicios
    </h4>
    <ul class="space-y-4">
      <li>
        <a
          class="text-surface-dim hover:text-white hover:translate-x-1 transition-transform inline-block"
          href="/servicios/"
        >
          Instalación
        </a>
      </li>
      <li>
        <a
          class="text-surface-dim hover:text-white hover:translate-x-1 transition-transform inline-block"
          href="/servicios/"
        >
          Mantenimiento
        </a>
      </li>
      <li>
        <a
          class="text-surface-dim hover:text-white hover:translate-x-1 transition-transform inline-block"
          href="/servicios/"
        >
          Modernización
        </a>
      </li>
      <li>
        <a
          class="text-surface-dim hover:text-white hover:translate-x-1 transition-transform inline-block"
          href="/emergencias/"
        >
          Emergencias 24/7
        </a>
      </li>
    </ul>
  </div>
  <div>
    <h4
      class="text-white font-label-bold text-label-bold mb-6 uppercase tracking-wider"
    >
      Empresa
    </h4>
    <ul class="space-y-4">
      <li>
        <a
          class="text-surface-dim hover:text-white hover:translate-x-1 transition-transform inline-block"
          href="/nosotros/"
        >
          Nosotros
        </a>
      </li>
      <li>
        <a
          class="text-surface-dim hover:text-white hover:translate-x-1 transition-transform inline-block"
          href="/cotizacion/"
        >
          Contacto
        </a>
      </li>
      <li>
        <a
          class="text-surface-dim hover:text-white hover:translate-x-1 transition-transform inline-block"
          href="/proyectos/"
        >
          Proyectos
        </a>
      </li>
      <li>
        <a
          class="text-surface-dim hover:text-white hover:translate-x-1 transition-transform inline-block"
          href="/emergencias/"
        >
          Emergencias
        </a>
      </li>
    </ul>
  </div>
  <div>
    <h4
      class="text-white font-label-bold text-label-bold mb-6 uppercase tracking-wider"
    >
      Contacto
    </h4>
    <p class="text-surface-dim mb-4">
      {siteConfig.legalName}<br />
      {siteConfig.contact.email}
    </p>
    <p class="text-white font-bold mb-4">{siteConfig.contact.phone}</p>
    <div class="flex gap-4">
      <a
        class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center hover:bg-white hover:text-navy-deep transition-all"
        href="#"
      >
        <span class="material-symbols-outlined text-sm">alternate_email</span>
      </a>
      <a
        class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center hover:bg-white hover:text-navy-deep transition-all"
        href="#"
      >
        <span class="material-symbols-outlined text-sm">share</span>
      </a>
    </div>
  </div>
  <div
    class="md:col-span-4 pt-section-padding border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4"
  >
    <span class="text-surface-dim text-sm">
      © 2026 {siteConfig.legalName}. Todos los derechos reservados. | <span class="text-white">By <a href="https://www.pivotit.cl" target="_blank" class="hover:text-blue-300">Pivot IT.</a></span>
    </span>
    <div class="flex gap-8 text-sm text-surface-dim">
      <a class="hover:text-white" href="/terminos/">Términos</a>
      <a class="hover:text-white" href="/privacidad/">Privacidad</a>
      <a class="hover:text-white" href="/privacidad/#cookies">Cookies</a>
    </div>
  </div>
</footer>
