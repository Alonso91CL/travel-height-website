# Copia este archivo a .env y rellena los valores reales.
# El .env NO se versiona (está en .gitignore). Nunca subir claves reales a Git.
# En cPanel, estas variables se definen en Setup Node.js App > Environment variables.

# API Key de Resend (https://resend.com/api-keys). El dominio del remitente
# debe estar verificado en Resend para poder enviar.
RESEND_API_KEY=

# Email destinatario de los formularios (contacto y cotización).
CONTACT_TO=contacto@travelheight.cl

# Remitente usado por Resend. Debe ser un dominio verificado en Resend
# (p. ej. "Travel Height <no-reply@travelheight.cl>").
CONTACT_FROM=Travel Height <no-reply@travelheight.cl>