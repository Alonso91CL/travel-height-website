# NOTA: dist/ NO se ignora a proposito: los hosts compartidos cPanel no
# tienen RAM para compilar Astro en el servidor (OOM). Se compila localmente
# y el build se versiona para que .cpanel.yml solo tenga que reiniciar.

# passenger restart marker (cpanel)
tmp/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables / secrets
.env
.env.*
!.env.example

# logs
*.log

# build caches
*.tsbuildinfo

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini

# jetbrains setting folder
.idea/

# local screenshots / notes (not project assets)
image.png

# stitch design reference (not part of the project)
stitch-demo/
